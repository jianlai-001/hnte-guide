{
  "name": "hnte-application-guide",
  "version": "0.5.0",
  "private": true,
  "description": "本地优先的高新技术企业认定资料审核、智能整理与文件起草工作台",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-project.mjs",
    "build:globe": "esbuild assets/command-center-entry.js --bundle --minify --format=esm --target=es2020 --outfile=assets/vendor/command-center.bundle.js",
    "build:experience": "esbuild assets/experience-entry.js --bundle --minify --format=iife --target=es2020 --outfile=assets/vendor/experience.bundle.js",
    "build:forest": "esbuild 森林交互/forest-entry.js --bundle --minify --format=iife --target=es2020 --outfile=森林交互/forest.bundle.js",
    "build": "npm run build:globe && npm run build:experience && npm run build:forest",
    "vendor": "node scripts/vendor-assets.mjs",
    "start": "node scripts/serve.mjs",
    "serve": "npx --yes serve ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "jszip": "^3.10.2",
    "lenis": "^1.3.27",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.12",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
